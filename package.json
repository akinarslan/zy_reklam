{
  "name": "zy-reklam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run generate:pages && vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "npm run generate:pages && npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "generate:promotions": "node scripts/generate-promotions.mjs",
    "generate:pages": "node scripts/generate-services.mjs && node scripts/generate-projects.mjs"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
